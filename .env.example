# Copier ce fichier vers .env. Ne jamais versionner .env.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
PORT=8765
# Chemin relatif au projet ou chemin absolu vers les exports du scraper.
SCRAPER_EXPORT_DIR=scraper/exports
# Facultatif : ancien CSV enrichi à reprendre au premier import.
SEED_CSV=
# Coller ici l’URL de la page d’annonces Trendtrack pour le scraper fourni.
TRENDTRACK_URL=https://app.trendtrack.io
# Supabase : connexion Session pooler, compte serveur ad_pipeline_app.
# Vide = mode SQLite local. Aucun repli automatique si Supabase est indisponible.
SUPABASE_DB_URL=
# Certificat CA téléchargé depuis Database > Settings > SSL Configuration.
SUPABASE_SSLROOTCERT=
# Vercel uniquement : variables à ajouter dans Settings > Environment Variables.
PIPELINE_USER=admin
# Mot de passe du site : au moins 24 caractères aléatoires.
PIPELINE_PASSWORD=
