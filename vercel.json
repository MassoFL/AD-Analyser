{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{.venv/**,.env*,data/**,scraper/**,tests/**,.git/**,supabase/**,work/**}"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
